### Localización
d-i debian-installer/locale string es_ES.UTF-8
d-i debian-installer/language string es
d-i debian-installer/country string CO
d-i keyboard-configuration/xkb-keymap select es

### Red
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string debian
d-i netcfg/get_domain string unassigned-domain
d-i netcfg/enable boolean true
d-i netcfg/dhcp_timeout string 60
d-i netcfg/disable_dhcp boolean false

### Repositorios
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

### Usuarios y contraseñas
d-i passwd/root-login boolean true
d-i passwd/root-password password your_pass_chenge
d-i passwd/root-password-again password your_pass_chenge
d-i passwd/make-user boolean false

### Zona horaria
d-i clock-setup/utc boolean true
d-i time/zone string America/Bogota
d-i clock-setup/ntp boolean true

### Particionado de discos
d-i partman-auto/disk string /dev/sda
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-auto/method string lvm
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

### Selección de software
tasksel tasksel/first multiselect
d-i pkgsel/include string openssh-server
d-i pkgsel/install-pattern string
d-i pkgsel/upgrade select none
popularity-contest popularity-contest/participate boolean false

### Instalación de GRUB
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string /dev/sda

# Habilitar acceso SSH root
#d-i preseed/late_command string in-target sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
d-i preseed/late_command string \
    in-target sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config; \
    in-target sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config; \
    in-target systemctl enable ssh; \
    in-target systemctl restart ssh;
### Finalización
d-i finish-install/reboot_in_progress note